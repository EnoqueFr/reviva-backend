# Copie este arquivo para ".env" e preencha com os valores reais.
# NUNCA suba o arquivo ".env" (com valores reais) pro GitHub — ele já está no .gitignore.

# String de conexão do banco Postgres.
# Pode ser o Postgres do Supabase (Project Settings > Database > Connection string > URI),
# ou qualquer outro Postgres (Render, Railway, Neon).
DATABASE_URL=postgresql://usuario:senha@host:5432/nome_do_banco

# Segredo usado pra assinar os tokens JWT de login dos colaboradores.
# Gere um valor aleatório forte, por exemplo rodando no terminal:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque_por_um_valor_aleatorio_e_secreto

# Por quanto tempo o login do colaborador fica valendo.
JWT_EXPIRES_IN=8h

# Porta em que a API sobe localmente (a hospedagem em produção geralmente define isso sozinha).
PORT=3333

# URL do site (usada pro CORS — só essa origem pode chamar a API).
# Em produção, aponte pro domínio real do Vercel.
FRONTEND_ORIGIN=https://projetoreviva.vercel.app
